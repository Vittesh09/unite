<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_moon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_moon_disc"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:contentDescription="@string/moon_widget_description"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_moon_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/moon_widget_placeholder_name"
        android:textColor="#F7F4EE"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_moon_illum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/moon_widget_placeholder_illum"
        android:textColor="#D8DEE8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_moon_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="#D0D6E2"
        android:textSize="9sp" />
</LinearLayout>
